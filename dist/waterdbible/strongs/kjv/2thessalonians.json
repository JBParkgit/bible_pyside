,{"text":"be"},{"text":"revealed","strongs":["G0601"]},{"text":", the"},{"text":"son","strongs":["G5207"]},{"text":"of"},{"text":"perdition","strongs":["G0684"]},{"text":";"}]},{"number":4,"text":"Who opposeth and exalteth himself above all that is called God, or that is worshipped; so that he as God sitteth in the temple of God, shewing himself that he is God.","tokens":[{"text":"Who"},{"text":"opposeth","strongs":["G0480"]},{"text":"and","strongs":["G2532"]},{"text":"exalteth"},{"text":"himself","strongs":["G5229"]},{"text":"above","strongs":["G1909"]},{"text":"all","strongs":["G3956"]},{"text":"that is"},{"text":"called","strongs":["G3004"]},{"text":"God","strongs":["G2316"]},{"text":","},{"text":"or","strongs":["G2228"]},{"text":"that is"},{"text":"worshipped","strongs":["G4574"]},{"text":"; so"},{"text":"that","strongs":["G5620"]},{"text":"he","strongs":["G0846"]},{"text":"as","strongs":["G5613"]},{"text":"God","strongs":["G2316"]},{"text":"sitteth","strongs":["G2523"]},{"text":"in","strongs":["G1519"]},{"text":"the"},{"text":"temple","strongs":["G3485"]},{"text":"of"},{"text":"God","strongs":["G2316"]},{"text":","},{"text":"shewing","strongs":["G0584"]},{"text":"himself","strongs":["G1438"]},{"text":"that","strongs":["G3754"]},{"text":"he"},{"text":"is","strongs":["G2076"]},{"text":"God","strongs":["G2316"]},{"text":"."}]},{"number":5,"text":"Remember ye not, that, when I was yet with you, I told you these things?","tokens":[{"text":"Remember"},{"text":"ye","strongs":["G3421"]},{"text":"not","strongs":["G3756"]},{"text":","},{"text":"that","strongs":["G3754"]},{"text":", when I"},{"text":"was","strongs":["G5607"]},{"text":"yet","strongs":["G2089"]},{"text":"with","strongs":["G4314"]},{"text":"you","strongs":["G5209"]},{"text":", I"},{"text":"told","strongs":["G3004"]},{"text":"you","strongs":["G5213"]},{"text":"these"},{"text":"things","strongs":["G5023"]},{"text":"?"}]},{"number":6,"text":"And now ye know what withholdeth that he might be revealed in his time