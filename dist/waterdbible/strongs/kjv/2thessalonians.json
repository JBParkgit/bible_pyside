6,"text":"Now our Lord Jesus Christ himself, and God, even our Father, which hath loved us, and hath given us everlasting consolation and good hope through grace,","tokens":[{"text":"Now","strongs":["G1161"]},{"text":"our","strongs":["G2257"]},{"text":"Lord","strongs":["G2962"]},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":"himself","strongs":["G0846"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"God","strongs":["G2316"]},{"text":","},{"text":"even","strongs":["G2532"]},{"text":"our","strongs":["G2257"]},{"text":"Father","strongs":["G3962"]},{"text":", which hath"},{"text":"loved","strongs":["G0025"]},{"text":"us","strongs":["G2248"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"hath"},{"text":"given","strongs":["G1325"]},{"text":"us"},{"text":"everlasting","strongs":["G0166"]},{"text":"consolation","strongs":["G3874"]},{"text":"and","strongs":["G2532"]},{"text":"good","strongs":["G0018"]},{"text":"hope","strongs":["G1680"]},{"text":"through","strongs":["G1722"]},{"text":"grace","strongs":["G5485"]},{"text":","}]},{"number":17,"text":"Comfort your hearts, and stablish you in every good word and work.","tokens":[{"text":"Comfort","strongs":["G3870"]},{"text":"your","strongs":["G5216"]},{"text":"hearts","strongs":["G2588"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"stablish","strongs":["G4741"]},{"text":"you","strongs":["G5209"]},{"text":"in","strongs":["G1722"]},{"text":"every","strongs":["G3956"]},{"text":"good","strongs":["G0018"]},{"text":"word","strongs":["G3056"]},{"text":"and","strongs":["G2532"]},{"text":"work","strongs":["G2041"]},{"text":"."}]}]},"3":{"verses":[{"number":1,"text":"Finally, brethren, pray for us, that the word of the Lord may have free course, and be glorified, even as it is with you:","tokens":[{"text":"Finally","strongs":["G3063"]},{"text":","},{"text":"brethren","strongs":["G0080"]},{"text":","},{"text":"pray","strongs":["G4336"]},{"text":"for","strongs":["G4012"]},{"text":"us","strongs":["G2257"]},{"text":","},{"text":"that","strongs":["G2443"]},{"text":"the"},{"text":"word","strongs":["G3056"]},{"text":"of the"},{"text":"Lord","strongs":["G2962"]},{"text":"may"},{"text":"have","strongs":["G5143"]},{"text":"free"},{"text":"course","strongs":["G5143"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"be"},{"text":"glorified","strongs":["G1392"]},{"text":","},{"text":"even","strongs":["G2532"]},{"text":"as","strongs":["G2531"]},{"text":"it is"},{"text":"with","strongs":["G4314"]},{"text":"you","strongs":["G5209"]},{"text":":"}]},{"number":2,"text":"And that we may be delivered from unreasonable and wicked men: for all men have not faith.","tokens":[{"text":"And","strongs":["G2532"]},{"text":"that","strongs":["G2443"]},{"text":"we may be"},{"text":"delivered","strongs":["G4506"]},{"text":"from","strongs":["G0575"]},{"text":"unreasonable","strongs":["G0824"]},{"text":"and","strongs":["G2532"]},{"text":"wicked","strongs":["G4190"]},{"text":"men","strongs":["G0444"]},{"text":":"},{"text":"for","strongs":["G1063"]},{"text":"all","strongs":["G3956"]},{"text":"men have"},{"text":"not","strongs":["G3756"]},{"text":"faith","strongs":["G4102"]},{"text":"."}]},{"number":3,"text":"But the Lord is faithful, who shall stablish you, and keep you from evil.","tokens":[{"text":"But","strongs":["G1161"]},{"text":"the"},{"text":"Lord","strongs":["G2962"]},{"text":"is","strongs":["G2076"]},{"text":"faithful","strongs":["G4103"]},{"text":","},{"text":"who","strongs":["G3739"]},{"text":"shall"},{"text":"stablish","strongs":["G4741"]},{"text":"you","strongs":["G5209"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"keep","strongs":["G5442"]},{"text":"you"},{"text":"from","strongs":["G0575"]},{"text":"evil","strongs":["G4190"]},{"text":"."}]},{"number":4,"text":"And we have confidence in the Lord touching you, that ye both do and will do the things which we command you.","tokens":[{"text":"And","strongs":["G1161"]},{"text":"we have"},{"text":"confidence","strongs":["G3982"]},{"text":"in","strongs":["G1722"]},{"text":"the"},{"text":"Lord","strongs":["G2962"]},{"text":"touching","strongs":["G1909"]},{"text":"you","strongs":["G5209"]},{"text":","},{"text":"that","strongs":["G3754"]},{"text":"ye","strongs":["G4160"]},{"text":"both","strongs":["G2532"]},{"text":"do","strongs":["G4160"]},{"text":"and","strongs":["G2532"]},{"text":"will"},{"text":"do","strongs":["G4160"]},{"text":"the things"},{"text":"which","strongs":["G3739"]},{"text":"we"},{"text":"command","strongs":["G3853"]},{"text":"you","strongs":["G5213"]},{"text":"."}]},{"number":5,"text":"And the Lord direct your hearts into the love of God, and into the patient waiting for Christ.","tokens":[{"text":"And","strongs":["G1161"]},{"text":"the"},{"text":"Lord","strongs":["G2962"]},{"text":"direct","strongs":["G2720"]},{"text":"your","strongs":["G5216"]},{"text":"hearts","strongs":["G2588"]},{"text":"into","strongs":["G1519"]},{"text":"the"},{"text":"love","strongs":["G0026"]},{"text":"of"},{"text":"God","strongs":["G2316"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"into","strongs":["G1519"]},{"text":"the patient"},{"text":"waiting","strongs":["G5281"]},{"text":"for"},{"text":"Christ","strongs":["G5547"]},{"text":"."}]},{"number":6,"text":"Now we command you, brethren, in the name of our Lord Jesus Christ, that ye withdraw yourselves from every brother that walketh disorderly, and not after the tradition which he received of us.","tokens":[{"text":"Now","strongs":["G1161"]},{"text":"we"},{"text":"command","strongs":["G3853"]},{"text":"you","strongs":["G5213"]},{"text":","},{"text":"brethren","strongs":["G0080"]},{"text":","},{"text":"in","strongs":["G1722"]},{"text":"the"},{"text":"name","strongs":["G3686"]},{"text":"of"},{"text":"our","strongs":["G2257"]},{"text":"Lord","strongs":["G2962"]},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":","},{"text":"that","strongs":["G4724"]},{"text":"ye","strongs":["G5209"]},{"text":"withdraw"},{"text":"yourselves","strongs":["G4724"]},{"text":"from","strongs":["G0575"]},{"text":"every","strongs":["G3956"]},{"text":"brother","strongs":["G0080"]},{"text":"that"},{"text":"walketh","strongs":["G4043"]},{"text":"disorderly","strongs":["G0814"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"not","strongs":["G3361"]},{"text":"after","strongs":["G2596"]},{"text":"the"},{"text":"tradition","strongs":["G3862"]},{"text":"which","strongs":["G3739"]},{"text":"he"},{"text":"received","strongs":["G3880"]},{"text":"of","strongs":["G3844"]},{"text":"us","strongs":["G2257"]},{"text":"."}]},{"number":7,"text":"For yourselves know how ye ought to follow us: for we behaved not ourselves disorderly among you;","tokens":[{"text":"For","strongs":["G1063"]},{"text":"yourselves","strongs":["G0846"]},{"text":"know","strongs":["G1492"]},{"text":"how","strongs":["G4459"]},{"text":"ye"},{"text":"ought","strongs":["G1163"]},{"text":"to"},{"text":"follow","strongs":["G3401"]},{"text":"us","strongs":["G2248"]},{"text":":"},{"text":"for","strongs":["G3754"]},{"text":"we"},{"text":"behaved","strongs":["G0812"]},{"text":"not","strongs":["G3756"]},{"text":"ourselves"},{"text":"disorderly","strongs":["G0812"]},{"text":"among","strongs":["G1722"]},{"text":"you","strongs":["G5213"]},{"text":";"}]},{"number":8,"text":"Neither did we eat any man’s bread for nought; but wrought with labour and travail night and day, that we might not be chargeable to any of you:","tokens":[{"text":"Neither","strongs":["G3761"]},{"text":"did we"},{"text":"eat","strongs":["G5315"]},{"text":"any"},{"text":"man’s","strongs":["G5100"]},{"text":"bread","strongs":["G0740"]},{"text":"for"},{"text":"nought","strongs":["G1432"]},{"text":";"},{"text":"but","strongs":["G0235"]},{"text":"wrought","strongs":["G2038"]},{"text":"with","strongs":["G1722"]},{"text":"labour","strongs":["G2873"]},{"text":"and","strongs":["G2532"]},{"text":"travail","strongs":["G3449"]},{"text":"night","strongs":["G3571"]},{"text":"and","strongs":["G2532"]},{"text":"day","strongs":["G2250"]},{"text":","},{"text":"that","strongs":["G4314"]},{"text":"we"},{"text":"might","strongs":["G1912"]},{"text":"not","strongs":["G3361"]},{"text":"be chargeable"},{"text":"to","strongs":["G1912"]},{"text":"any","strongs":["G5100"]},{"text":"of"},{"text":"you","strongs":["G5216"]},{"text":":"}]},{"number":9,"text":"Not because we have not power, but to make ourselves an ensample unto you to follow us.","tokens":[{"text":"Not","strongs":["G3756"]},{"text":"because","strongs":["G3754"]},{"text":"we"},{"text":"have","strongs":["G2192"]},{"text":"not","strongs":["G3756"]},{"text":"power","strongs":["G1849"]},{"text":","},{"text":"but","strongs":["G0235"]},{"text":"to","strongs":["G2443"]},{"text":"make","strongs":["G1325"]},{"text":"ourselves","strongs":["G1438"]},{"text":"an"},{"text":"ensample","strongs":["G5179"]},{"text":"unto"},{"text":"you","strongs":["G5213"]},{"text":"to","strongs":["G1519"]},{"text":"follow","strongs":["G3401"]},{"text":"us","strongs":["G2248"]},{"text":"."}]},{"number":10,"text":"For even when we were with you, this we commanded you, that if any would not work, neither should he eat.","tokens":[{"text":"For","strongs":["G1063"]},{"text":"even","strongs":["G2532"]},{"text":"when","strongs":["G3753"]},{"text":"we"},{"text":"were","strongs":["G1510"]},{"text":"with","strongs":["G4314"]},{"text":"you","strongs":["G5209"]},{"text":","},{"text":"this","strongs":["G5124"]},{"text":"we"},{"text":"commanded","strongs":["G3853"]},{"text":"you","strongs":["G5213"]},{"text":","},{"text":"that","strongs":["G3754"]},{"text":"if","strongs":["G1487"]},{"text":"any","strongs":["G5100"]},{"text":"would","strongs":["G2309"]},{"text":"not","strongs":["G3756"]},{"text":"work","strongs":["G2038"]},{"text":","},{"text":"neither","strongs":["G3366"]},{"text":"should he"},{"text":"eat","strongs":["G2068"]},{"text":"."}]},{"number":11,"text":"For we hear that there are some which walk among you disorderly, working not at all, but are busybodies.","tokens":[{"text":"For","strongs":["G1063"]},{"text":"we"},{"text":"hear","strongs":["G0191"]},{"text":"that there"},{"text":"are","strongs":["G4043"]},{"text":"some","strongs":["G5100"]},{"text":"which"},{"text":"walk","strongs":["G4043"]},{"text":"among","strongs":["G1722"]},{"text":"you","strongs":["G5213"]},{"text":"disorderly","strongs":["G0814"]},{"text":","},{"text":"working","strongs":["G2038"]},{"text":"not at"},{"text":"all","strongs":["G3367"]},{"text":","},{"text":"but","strongs":["G0235"]},{"text":"are"},{"text":"busybodies","strongs":["G4020"]},{"text":"."}]},{"number":12,"text":"Now them that are such we command and exhort by our Lord Jesus Christ, that with quietness they work, and eat their own bread.","tokens":[{"text":"Now","strongs":["G1161"]},{"text":"them that are"},{"text":"such","strongs":["G5108"]},{"text":"we"},{"text":"command","strongs":["G3853"]},{"text":"and","strongs":["G2532"]},{"text":"exhort","strongs":["G3870"]},{"text":"by","strongs":["G1223"]},{"text":"our","strongs":["G2257"]},{"text":"Lord","strongs":["G2962"]},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":","},{"text":"that","strongs":["G2443"]},{"text":"with","strongs":["G3326"]},{"text":"quietness","strongs":["G2271"]},{"text":"they"},{"text":"work","strongs":["G2038"]},{"text":", and"},{"text":"eat","strongs":["G2068"]},{"text":"their"},{"text":"own","strongs":["G1438"]},{"text":"bread","strongs":["G0740"]},{"text":"."}]},{"number":13,"text":"But ye, brethren, be not weary in well doing.","tokens":[{"text":"But","strongs":["G1161"]},{"text":"ye","strongs":["G5210"]},{"text":","},{"text":"brethren","strongs":["G0080"]},{"text":","},{"text":"be","strongs":["G1573"]},{"text":"not","strongs":["G3361"]},{"text":"weary","strongs":["G1573"]},{"text":"in well"},{"text":"doing","strongs":["G2569"]},{"text":"."}]},{"number":14,"text":"And if any man obey not our word by this epistle, note that man, and have no company with him, that he may be ashamed.","tokens":[{"text":"And","strongs":["G1161"]},{"text":"if","strongs":["G1487"]},{"text":"any"},{"text":"man","strongs":["G5100"]},{"text":"obey","strongs":["G5219"]},{"text":"not","strongs":["G3756"]},{"text":"our","strongs":["G2257"]},{"text":"word","strongs":["G3056"]},{"text":"by","strongs":["G1223"]},{"text":"this"},{"text":"epistle","strongs":["G1992"]},{"text":","},{"text":"note","strongs":["G4593"]},{"text":"that"},{"text":"man","strongs":["G5126"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"have","strongs":["G4874"]},{"text":"no","strongs":["G3361"]},{"text":"company"},{"text":"with","strongs":["G4874"]},{"text":"him","strongs":["G0846"]},{"text":","},{"text":"that","strongs":["G2443"]},{"text":"he may be"},{"text":"ashamed","strongs":["G1788"]},{"text":"."}]},{"number":15,"text":"Yet count him not as an enemy, but admonish him as a brother.","tokens":[{"text":"Yet","strongs":["G2532"]},{"text":"count","strongs":["G2233"]},{"text":"him"},{"text":"not","strongs":["G3361"]},{"text":"as","strongs":["G5613"]},{"text":"an"},{"text":"enemy","strongs":["G2190"]},{"text":","},{"text":"but","strongs":["G0235"]},{"text":"admonish","strongs":["G3560"]},{"text":"him"},{"text":"as","strongs":["G5613"]},{"text":"a"},{"text":"brother","strongs":["G0080"]},{"text":"."}]},{"number":16,"text":"Now the Lord of peace himself give you peace always by all means. The Lord be with you all.","tokens":[{"text":"Now","strongs":["G1161"]},{"text":"the"},{"text":"Lord","strongs":["G2962"]},{"text":"of"},{"text":"peace","strongs":["G1515"]},{"text":"himself","strongs":["G0846"]},{"text":"give","strongs":["G1325"]},{"text":"you","strongs":["G5213"]},{"text":"peace","strongs":["G1515"]},{"text":"always","strongs":["G1223"]},{"text":"by","strongs":["G1722"]},{"text":"all","strongs":["G3956"]},{"text":"means","strongs":["G5158"]},{"text":". The"},{"text":"Lord","strongs":["G2962"]},{"text":"be"},{"text":"with","strongs":["G3326"]},{"text":"you","strongs":["G5216"]},{"text":"all","strongs":["G3956"]},{"text":"."}]},{"number":17,"text":"The salutation of Paul with mine own hand, which is the token in every epistle: so I write.","tokens":[{"text":"The"},{"text":"salutation","strongs":["G0783"]},{"text":"of"},{"text":"Paul","strongs":["G3972"]},{"text":"with mine"},{"text":"own","strongs":["G1699"]},{"text":"hand","strongs":["G5495"]},{"text":","},{"text":"which","strongs":["G3739"]},{"text":"is","strongs":["G2076"]},{"text":"the"},{"text":"token","strongs":["G4592"]},{"text":"in","strongs":["G1722"]},{"text":"every","strongs":["G3956"]},{"text":"epistle","strongs":["G1992"]},{"text":":"},{"text":"so","strongs":["G3779"]},{"text":"I"},{"text":"write","strongs":["G1125"]},{"text":"."}]},{"number":18,"text":"The grace of our Lord Jesus Christ be with you all. Amen. The second epistle to the Thessalonians was written from Athens.","tokens":[{"text":"The"},{"text":"grace","strongs":["G5485"]},{"text":"of"},{"text":"our","strongs":["G2257"]},{"text":"Lord","strongs":["G2962"]},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":"be"},{"text":"with","strongs":["G3326"]},{"text":"you","strongs":["G5216"]},{"text":"all","strongs":["G3956"]},{"text":"."},{"text":"Amen","strongs":["G0281"]},{"text":". The second epistle to the Thessalonians was written from Athens."}]}]}}}