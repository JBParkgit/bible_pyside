ion:","tokens":[{"text":"For","strongs":["G1063"]},{"text":"there"},{"text":"are","strongs":["G1526"]},{"text":"many","strongs":["G4183"]},{"text":"unruly","strongs":["G0506"]},{"text":"and","strongs":["G2532"]},{"text":"vain"},{"text":"talkers","strongs":["G3151"]},{"text":"and","strongs":["G2532"]},{"text":"deceivers","strongs":["G5423"]},{"text":","},{"text":"specially","strongs":["G3122"]},{"text":"they","strongs":["G3588"]},{"text":"of","strongs":["G1537"]},{"text":"the"},{"text":"circumcision","strongs":["G4061"]},{"text":":"}]},{"number":11,"text":"Whose mouths must be stopped, who subvert whole houses, teaching things which they ought not, for filthy lucre’s sake.","tokens":[{"text":"Whose","strongs":["G3739"]},{"text":"mouths","strongs":["G1993"]},{"text":"must","strongs":["G1163"]},{"text":"be"},{"text":"stopped","strongs":["G1993"]},{"text":","},{"text":"who","strongs":["G3748"]},{"text":"subvert","strongs":["G0396"]},{"text":"whole","strongs":["G3650"]},{"text":"houses","strongs":["G3624"]},{"text":","},{"text":"teaching","strongs":["G1321"]},{"text":"things"},{"text":"which","strongs":["G3739"]},{"text":"they"},{"text":"ought","strongs":["G1163"]},{"text":"not","strongs":["G3361"]},{"text":","},{"text":"for","strongs":["G5484"]},{"text":"filthy","strongs":["G0150"]},{"text":"lucre’s","strongs":["G2771"]},{"text":"sake","strongs":["G5484"]},{"text":"."}]},{"number":12,"text":"One of themselves, even a prophet of their own, said, The Cretians are alway liars, evil beasts, slow bellies.","tokens":[{"text":"One","strongs":["G5100"]},{"text":"of","strongs":["G1537"]},{"text":"themselves","strongs":["G0846"]},{"text":", even a"},{"text":"prophet","strongs":["G4396"]},{"text":"of"},{"text":"their","strongs":["G0846"]},{"text":"own","strongs":["G2398"]},{"text":","},{"text":"said","strongs":["G2036"]},{"text":", The"},{"text":"Cretians","strongs":["G2912"]},{"text":"are"},{"text":"alway","strongs":["G0104"]},{"text":"liars","strongs":["G5583"]},{"text":","},{"t