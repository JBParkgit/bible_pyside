text":"in","strongs":["G1722"]},{"text":"Crete","strongs":["G2914"]},{"text":","},{"text":"that","strongs":["G2443"]},{"text":"thou shouldest set in"},{"text":"order","strongs":["G1930"]},{"text":"the"},{"text":"things","strongs":["G3588"]},{"text":"that are"},{"text":"wanting","strongs":["G3007"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"ordain","strongs":["G2525"]},{"text":"elders","strongs":["G4245"]},{"text":"in"},{"text":"every","strongs":["G2596"]},{"text":"city","strongs":["G4172"]},{"text":","},{"text":"as","strongs":["G5613"]},{"text":"I","strongs":["G1473"]},{"text":"had"},{"text":"appointed","strongs":["G1299"]},{"text":"thee","strongs":["G4671"]},{"text":":"}]},{"number":6,"text":"If any be blameless, the husband of one wife, having faithful children not accused of riot or unruly.","tokens":[{"text":"If","strongs":["G1487"]},{"text":"any","strongs":["G5100"]},{"text":"be","strongs":["G2076"]},{"text":"blameless","strongs":["G0410"]},{"text":", the"},{"text":"husband","strongs":["G0435"]},{"text":"of"},{"text":"one","strongs":["G1520"]},{"text":"wife","strongs":["G1135"]},{"text":","},{"text":"having","strongs":["G2192"]},{"text":"faithful","strongs":["G4103"]},{"text":"children","strongs":["G5043"]},{"text":"not","strongs":["G3361"]},{"text":"accused","strongs":["G2724"]},{"text":"of"},{"text":"riot","strongs":["G0810"]},{"text":"or","strongs":["G2228"]},{"text":"unruly","strongs":["G0506"]},{"text":"."}]},{"number":7,"text":"For a bishop must be blameless, as the steward of God; not selfwilled, not soon angry, not given to wine, no striker, not given to filthy lucre;","tokens":[{"text":"For","strongs":["G1063"]},{"text":"a"},{"text":"bishop","strongs":["G1985"]},{"text":"must","strongs":["G1163"]},{"text":"be","strongs":["G1511"]},{"text":"blameless","strongs":["G0410"]},{"text":","},{"text":"as","strongs":["G5613"]},{"text":"the"},{"text":"steward","strongs":["G3623"]},{"text":"of"},{"text":"God","strongs":["G2316"]},{"text":";"},{"text