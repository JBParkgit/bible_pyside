nd","strongs":["G5198"]},{"text":"in"},{"text":"faith","strongs":["G4102"]},{"text":", in"},{"text":"charity","strongs":["G0026"]},{"text":", in"},{"text":"patience","strongs":["G5281"]},{"text":"."}]},{"number":3,"text":"The aged women likewise, that they be in behaviour as becometh holiness, not false accusers, not given to much wine, teachers of good things;","tokens":[{"text":"The aged"},{"text":"women","strongs":["G4247"]},{"text":"likewise","strongs":["G5615"]},{"text":","},{"text":"that","strongs":["G3361"]},{"text":"they be"},{"text":"in","strongs":["G1722"]},{"text":"behaviour","strongs":["G2688"]},{"text":"as becometh"},{"text":"holiness","strongs":["G2412"]},{"text":","},{"text":"not","strongs":["G3361"]},{"text":"false"},{"text":"accusers","strongs":["G1228"]},{"text":","},{"text":"not","strongs":["G3361"]},{"text":"given","strongs":["G1402"]},{"text":"to"},{"text":"much","strongs":["G4183"]},{"text":"wine","strongs":["G3631"]},{"text":", teachers of good"},{"text":"things","strongs":["G2567"]},{"text":";"}]},{"number":4,"text":"That they may teach the young women to be sober, to love their husbands, to love their children,","tokens":[{"text":"That","strongs":["G2443"]},{"text":"they may"},{"text":"teach","strongs":["G4994"]},{"text":"the young"},{"text":"women","strongs":["G3501"]},{"text":"to be"},{"text":"sober","strongs":["G4994"]},{"text":", to love their"},{"text":"husbands","strongs":["G5362"]},{"text":", to love their"},{"text":"children","strongs":["G5388"]},{"text":","}]},{"number":5,"text":"To be discreet, chaste, keepers at home, good, obedient to their own husbands, that the word of God be not blasphemed.","tokens":[{"text":"To be"},{"text":"discreet","strongs":["G4998"]},{"text":","},{"text":"chaste","strongs":["G0053"]},{"text":", keepers at"},{"text":"home","strongs":["G3626"]},{"text":","},{"text":"good","strongs":["G0018"]},{"text":","},{"text":"obedient","strongs":["G5293"]},{"text":"to their"},{"text":"own","strongs":["G2398"]},{"text