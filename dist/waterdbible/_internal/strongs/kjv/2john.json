{"bookId":"2john","version":"kjv-strong","source":"eBible KJV2006 USFM","chapters":{"1":{"verses":[{"number":1,"text":"The elder unto the elect lady and her children, whom I love in the truth; and not I only, but also all they that have known the truth;","tokens":[{"text":"The"},{"text":"elder","strongs":["G4245"]},{"text":"unto the"},{"text":"elect","strongs":["G1588"]},{"text":"lady","strongs":["G2959"]},{"text":"and","strongs":["G2532"]},{"text":"her","strongs":["G0846"]},{"text":"children","strongs":["G5043"]},{"text":","},{"text":"whom","strongs":["G3739"]},{"text":"I","strongs":["G1473"]},{"text":"love","strongs":["G0025"]},{"text":"in","strongs":["G1722"]},{"text":"the"},{"text":"truth","strongs":["G0225"]},{"text":";"},{"text":"and","strongs":["G2532"]},{"text":"not","strongs":["G3756"]},{"text":"I","strongs":["G1473"]},{"text":"only","strongs":["G3441"]},{"text":","},{"text":"but","strongs":["G0235"]},{"text":"also","strongs":["G2532"]},{"text":"all","strongs":["G3956"]},{"text":"they that have"},{"text":"known","strongs":["G1097"]},{"text":"the"},{"text":"truth","strongs":["G0225"]},{"text":";"}]},{"number":2,"text":"For the truth’s sake, which dwelleth in us, and shall be with us for ever.","tokens":[{"text":"For","strongs":["G1223"]},{"text":"the"},{"text":"truth’s sake","strongs":["G0225"]},{"text":","},{"text":"which","strongs":["G3588"]},{"text":"dwelleth","strongs":["G3306"]},{"text":"in","strongs":["G1722"]},{"text":"us","strongs":["G2254"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"shall"},{"text":"be","strongs":["G2071"]},{"text":"with","strongs":["G3326"]},{"text":"us","strongs":["G2257"]},{"text":"for","strongs":["G1519"]},{"text":"ever","strongs":["G0165"]},{"text":"."}]},{"number":3,"text":"Grace be with you, mercy, and peace, from God the Father, and from the Lord Jesus Christ, the Son of the Father, in truth and love.","tokens":[{"text":"Grace","strongs":["G5485"]},{"text":"be","strongs":["G2071"]},{"text":"with","strongs":["G3326"]},{"text":"you","strongs":["G2257"]},{"text":","},{"text":"mercy","strongs":["G1656"]},{"text":", and"},{"text":"peace","strongs":["G1515"]},{"text":","},{"text":"from","strongs":["G3844"]},{"text":"God","strongs":["G2316"]},{"text":"the"},{"text":"Father","strongs":["G3962"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"from","strongs":["G3844"]},{"text":"the"},{"text":"Lord","strongs":["G2962"]},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":", the"},{"text":"Son","strongs":["G5207"]},{"text":"of the"},{"text":"Father","strongs":["G3962"]},{"text":","},{"text":"in","strongs":["G1722"]},{"text":"truth","strongs":["G0225"]},{"text":"and","strongs":["G2532"]},{"text":"love","strongs":["G0026"]},{"text":"."}]},{"number":4,"text":"I rejoiced greatly that I found of thy children walking in truth, as we have received a commandment from the Father.","tokens":[{"text":"I"},{"text":"rejoiced","strongs":["G5463"]},{"text":"greatly","strongs":["G3029"]},{"text":"that","strongs":["G3754"]},{"text":"I"},{"text":"found","strongs":["G2147"]},{"text":"of","strongs":["G1537"]},{"text":"thy","strongs":["G4675"]},{"text":"children","strongs":["G5043"]},{"text":"walking","strongs":["G4043"]},{"text":"in","strongs":["G1722"]},{"text":"truth","strongs":["G0225"]},{"text":","},{"text":"as","strongs":["G2531"]},{"text":"we have"},{"text":"received","strongs":["G2983"]},{"text":"a"},{"text":"commandment","strongs":["G1785"]},{"text":"from","strongs":["G3844"]},{"text":"the"},{"text":"Father","strongs":["G3962"]},{"text":"."}]},{"number":5,"text":"And now I beseech thee, lady, not as though I wrote a new commandment unto thee, but that which we had from the beginning, that we love one another.","tokens":[{"text":"And","strongs":["G2532"]},{"text":"now","strongs":["G3568"]},{"text":"I"},{"text":"beseech","strongs":["G2065"]},{"text":"thee","strongs":["G4571"]},{"text":","},{"text":"lady","strongs":["G2959"]},{"text":","},{"text":"not","st