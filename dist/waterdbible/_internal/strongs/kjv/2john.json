rs","strongs":["G4108"]},{"text":"are"},{"text":"entered","strongs":["G1525"]},{"text":"into","strongs":["G1519"]},{"text":"the"},{"text":"world","strongs":["G2889"]},{"text":", who"},{"text":"confess","strongs":["G3670"]},{"text":"not","strongs":["G3361"]},{"text":"that"},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":"is"},{"text":"come","strongs":["G2064"]},{"text":"in","strongs":["G1722"]},{"text":"the"},{"text":"flesh","strongs":["G4561"]},{"text":"."},{"text":"This","strongs":["G3778"]},{"text":"is","strongs":["G2076"]},{"text":"a"},{"text":"deceiver","strongs":["G4108"]},{"text":"and","strongs":["G2532"]},{"text":"an"},{"text":"antichrist","strongs":["G0500"]},{"text":"."}]},{"number":8,"text":"Look to yourselves, that we lose not those things which we have wrought, but that we receive a full reward.","tokens":[{"text":"Look","strongs":["G0991"]},{"text":"to"},{"text":"yourselves","strongs":["G1438"]},{"text":","},{"text":"that","strongs":["G2443"]},{"text":"we"},{"text":"lose","strongs":["G0622"]},{"text":"not","strongs":["G3361"]},{"text":"those things"},{"text":"which","strongs":["G3739"]},{"text":"we have"},{"text":"wrought","strongs":["G2038"]},{"text":","},{"text":"but","strongs":["G0235"]},{"text":"that we"},{"text":"receive","strongs":["G0618"]},{"text":"a","strongs":["G3408"]},{"text":"full","strongs":["G4134"]},{"text":"reward","strongs":["G3408"]},{"text":"."}]},{"number":9,"text":"Whosoever transgresseth, and abideth not in the doctrine of Christ, hath not God. He that abideth in the doctrine of Christ, he hath both the Father and the Son.","tokens":[{"text":"Whosoever","strongs":["G3956"]},{"text":"transgresseth","strongs":["G3845"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"abideth","strongs":["G3306"]},{"text":"not","strongs":["G3361"]},{"text":"in","strongs":["G1722"]},{"text":"the"},{"text":"doctrine","strongs":["G1322"]},{"text":"of"},{"text":"Christ","strongs":["G5547"]},{"text":","},{"text