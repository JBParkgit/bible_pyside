e,"},{"text":"being","strongs":["G5607"]},{"text":"such an"},{"text":"one","strongs":["G5108"]},{"text":"as","strongs":["G5613"]},{"text":"Paul","strongs":["G3972"]},{"text":"the"},{"text":"aged","strongs":["G4246"]},{"text":","},{"text":"and","strongs":["G1161"]},{"text":"now","strongs":["G3570"]},{"text":"also","strongs":["G2532"]},{"text":"a"},{"text":"prisoner","strongs":["G1198"]},{"text":"of"},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":"."}]},{"number":10,"text":"I beseech thee for my son Onesimus, whom I have begotten in my bonds:","tokens":[{"text":"I"},{"text":"beseech","strongs":["G3870"]},{"text":"thee","strongs":["G4571"]},{"text":"for","strongs":["G4012"]},{"text":"my","strongs":["G1700"]},{"text":"son","strongs":["G5043"]},{"text":"Onesimus","strongs":["G3682"]},{"text":","},{"text":"whom","strongs":["G3739"]},{"text":"I have"},{"text":"begotten","strongs":["G1080"]},{"text":"in","strongs":["G1722"]},{"text":"my","strongs":["G3450"]},{"text":"bonds","strongs":["G1199"]},{"text":":"}]},{"number":11,"text":"Which in time past was to thee unprofitable, but now profitable to thee and to me:","tokens":[{"text":"Which","strongs":["G3588"]},{"text":"in time"},{"text":"past","strongs":["G4218"]},{"text":"was","strongs":["G3588"]},{"text":"to"},{"text":"thee","strongs":["G4671"]},{"text":"unprofitable","strongs":["G0890"]},{"text":","},{"text":"but","strongs":["G1161"]},{"text":"now","strongs":["G3570"]},{"text":"profitable","strongs":["G2173"]},{"text":"to"},{"text":"thee","strongs":["G4671"]},{"text":"and","strongs":["G2532"]},{"text":"to"},{"text":"me","strongs":["G1698"]},{"text":":"}]},{"number":12,"text":"Whom I have sent again: thou therefore receive him, that is, mine own bowels:","tokens":[{"text":"Whom","strongs":["G3739"]},{"text":"I have sent"},{"text":"again","strongs":["G0375"]},{"text":":"},{"text":"thou","strongs":["G4771"]},{"text":"therefore","strongs":["G1161"]},{"text":"receive","strongs":["G4355"]},{"text":"him","strongs":["G0846"]},{"text":","},{"text":"that","strongs":["G5124"]},{"text":"is","strongs":["G2076"]},{"text":", mine"},{"text":"own","strongs":["G1699"]},{"text":"bowels","strongs":["G4698"]},{"text":":"}]},{"number":13,"text":"Whom I would have retained with me, that in thy stead he might have ministered unto me in the bonds of the gospel:","tokens":[{"text":"Whom","strongs":["G3739"]},{"text":"I","strongs":["G1473"]},{"text":"would","strongs":["G1014"]},{"text":"have"},{"text":"retained","strongs":["G2722"]},{"text":"with","strongs":["G4314"]},{"text":"me","strongs":["G1683"]},{"text":","},{"text":"that","strongs":["G2443"]},{"text":"in","strongs":["G5228"]},{"text":"thy","strongs":["G4675"]},{"text":"stead","strongs":["G5228"]},{"text":"he might have"},{"text":"ministered","strongs":["G1247"]},{"text":"unto"},{"text":"me","strongs":["G3427"]},{"text":"in","strongs":["G1722"]},{"text":"the"},{"text":"bonds","strongs":["G1199"]},{"text":"of the"},{"text":"gospel","strongs":["G2098"]},{"text":":"}]},{"number":14,"text":"But without thy mind would I do nothing; that thy benefit should not be as it were of necessity, but willingly.","tokens":[{"text":"But","strongs":["G1161"]},{"text":"without","strongs":["G5565"]},{"text":"thy","strongs":["G4674"]},{"text":"mind","strongs":["G1106"]},{"text":"would"},{"text":"I","strongs":["G2309"]},{"text":"do","strongs":["G4160"]},{"text":"nothing","strongs":["G3762"]},{"text":";"},{"text":"that","strongs":["G2443"]},{"text":"thy","strongs":["G4675"]},{"text":"benefit","strongs":["G0018"]},{"text":"should"},{"text":"not","strongs":["G3361"]},{"text":"be","strongs":["G5600"]},{"text":"as it"},{"text":"were","strongs":["G5613"]},{"text":"of","strongs":["G2596"]},{"text":"necessity","strongs":["G0318"]},{"text":","},{"text":"but","strongs":["G0235"]},{"text":"willingly","strongs":["G1595"]},{"text":"."}]},{"number":15,"text":"For perhaps he therefore departed for a season, that thou shouldest receive him for ever;","tok