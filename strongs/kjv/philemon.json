"]},{"text":"as","strongs":["G5613"]},{"text":"myself","strongs":["G1691"]},{"text":"."}]},{"number":18,"text":"If he hath wronged thee, or oweth thee ought, put that on mine account;","tokens":[{"text":"If","strongs":["G1487"]},{"text":"he hath"},{"text":"wronged","strongs":["G0091"]},{"text":"thee","strongs":["G4571"]},{"text":","},{"text":"or","strongs":["G2228"]},{"text":"oweth","strongs":["G3784"]},{"text":"thee"},{"text":"ought","strongs":["G5100"]},{"text":","},{"text":"put","strongs":["G1677"]},{"text":"that","strongs":["G5124"]},{"text":"on"},{"text":"mine","strongs":["G1698"]},{"text":"account","strongs":["G1677"]},{"text":";"}]},{"number":19,"text":"I Paul have written it with mine own hand, I will repay it: albeit I do not say to thee how thou owest unto me even thine own self besides.","tokens":[{"text":"I","strongs":["G1473"]},{"text":"Paul","strongs":["G3972"]},{"text":"have"},{"text":"written","strongs":["G1125"]},{"text":"it with mine"},{"text":"own","strongs":["G1699"]},{"text":"hand","strongs":["G5495"]},{"text":","},{"text":"I","strongs":["G1473"]},{"text":"will"},{"text":"repay","strongs":["G0661"]},{"text":"it:"},{"text":"albeit","strongs":["G2443"]},{"text":"I"},{"text":"do","strongs":["G3004"]},{"text":"not","strongs":["G3361"]},{"text":"say","strongs":["G3004"]},{"text":"to"},{"text":"thee","strongs":["G4671"]},{"text":"how","strongs":["G3754"]},{"text":"thou"},{"text":"owest","strongs":["G4359"]},{"text":"unto"},{"text":"me","strongs":["G3427"]},{"text":"even","strongs":["G2532"]},{"text":"thine own"},{"text":"self","strongs":["G4572"]},{"text":"besides","strongs":["G4359"]},{"text":"."}]},{"number":20,"text":"Yea, brother, let me have joy of thee in the Lord: refresh my bowels in the Lord.","tokens":[{"text":"Yea","strongs":["G3483"]},{"text":","},{"text":"brother","strongs":["G0080"]},{"text":","},{"text":"let","strongs":["G3685"]},{"text":"me","strongs":["G1473"]},{"text":"have"},{"text":"joy","strongs":["G3685"]},{"text":"of"},{"text":"