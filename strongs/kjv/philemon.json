{"bookId":"philemon","version":"kjv-strong","source":"eBible KJV2006 USFM","chapters":{"1":{"verses":[{"number":1,"text":"Paul, a prisoner of Jesus Christ, and Timothy our brother, unto Philemon our dearly beloved, and fellowlabourer,","tokens":[{"text":"Paul","strongs":["G3972"]},{"text":", a"},{"text":"prisoner","strongs":["G1198"]},{"text":"of"},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"Timothy","strongs":["G5095"]},{"text":"our"},{"text":"brother","strongs":["G0080"]},{"text":", unto"},{"text":"Philemon","strongs":["G5371"]},{"text":"our","strongs":["G2257"]},{"text":"dearly"},{"text":"beloved","strongs":["G0027"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"fellowlabourer","strongs":["G4904"]},{"text":","}]},{"number":2,"text":"And to our beloved Apphia, and Archippus our fellowsoldier, and to the church in thy house:","tokens":[{"text":"And","strongs":["G2532"]},{"text":"to","strongs":["G0027"]},{"text":"our"},{"text":"beloved","strongs":["G0027"]},{"text":"Apphia","strongs":["G0682"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"Archippus","strongs":["G0751"]},{"text":"our","strongs":["G2257"]},{"text":"fellowsoldier","strongs":["G4961"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"to the"},{"text":"church","strongs":["G1577"]},{"text":"in","strongs":["G2596"]},{"text":"thy","strongs":["G4675"]},{"text":"house","strongs":["G3624"]},{"text":":"}]},{"number":3,"text":"Grace to you, and peace, from God our Father and the Lord Jesus Christ.","tokens":[{"text":"Grace","strongs":["G5485"]},{"text":"to"},{"text":"you","strongs":["G5213"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"peace","strongs":["G1515"]},{"text":","},{"text":"from","strongs":["G0575"]},{"text":"God","strongs":["G2316"]},{"text":"our","strongs":["G2257"]},{"text":"Father","strongs":["G3962"]},{"text":"and","strongs":["G2532"]},{"text":"the"},{"text":"Lord","strongs":["G2962"]},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":"."}]},{"number":4,"text":"I thank my God, making mention of thee always in my prayers,","tokens":[{"text":"I"},{"text":"thank","strongs":["G2168"]},{"text":"my","strongs":["G3450"]},{"text":"God","strongs":["G2316"]},{"text":","},{"text":"making","strongs":["G4160"]},{"text":"mention","strongs":["G3417"]},{"text":"of"},{"text":"thee","strongs":["G4675"]},{"text":"always","strongs":["G3842"]},{"text":"in","strongs":["G1909"]},{"text":"my","strongs":["G3450"]},{"text":"prayers","strongs":["G4335"]},{"text":","}]},{"number":5,"text":"Hearing of thy love and faith, which thou hast toward the Lord Jesus, and toward all saints;","tokens":[{"text":"Hearing","strongs":["G0191"]},{"text":"of"},{"text":"thy","strongs":["G4675"]},{"text":"love","strongs":["G0026"]},{"text":"and","strongs":["G2532"]},{"text":"faith","strongs":["G4102"]},{"text":","},{"text":"which","strongs":["G3739"]},{"text":"thou"},{"text":"hast","strongs":["G2192"]},{"text":"toward","strongs":["G4314"]},{"text":"the"},{"text":"Lord","strongs":["G2962"]},{"text":"Jesus","strongs":["G2424"]},{"text":","},{"text":"and","strongs":["G2532"]},{"text":"toward","strongs":["G1519"]},{"text":"all","strongs":["G3956"]},{"text":"saints","strongs":["G0040"]},{"text":";"}]},{"number":6,"text":"That the communication of thy faith may become effectual by the acknowledging of every good thing which is in you in Christ Jesus.","tokens":[{"text":"That","strongs":["G3704"]},{"text":"the"},{"text":"communication","strongs":["G2842"]},{"text":"of"},{"text":"thy","strongs":["G4675"]},{"text":"faith","strongs":["G4102"]},{"text":"may"},{"text":"become","strongs":["G1096"]},{"text":"effectual","strongs":["G1756"]},{"text":"by","strongs":["G1722"]},{"text":"the"},{"text":"acknowledging","strongs":["G1922"]},{"text":"of"},{"text":"every","strongs":["G3956"]},{"text":"good"},{"text":"thing","strongs":["G0018"]},{"text":"which"},{"t