"]},{"text":","},{"text":"my","strongs":["G3450"]},{"text":"fellowprisoner","strongs":["G4869"]},{"text":"in","strongs":["G1722"]},{"text":"Christ","strongs":["G5547"]},{"text":"Jesus","strongs":["G2424"]},{"text":";"}]},{"number":24,"text":"Marcus, Aristarchus, Demas, Lucas, my fellowlabourers.","tokens":[{"text":"Marcus","strongs":["G3138"]},{"text":","},{"text":"Aristarchus","strongs":["G0708"]},{"text":","},{"text":"Demas","strongs":["G1214"]},{"text":","},{"text":"Lucas","strongs":["G3065"]},{"text":","},{"text":"my","strongs":["G3450"]},{"text":"fellowlabourers","strongs":["G4904"]},{"text":"."}]},{"number":25,"text":"The grace of our Lord Jesus Christ be with your spirit. Amen. Written from Rome to Philemon, by Onesimus, a servant.","tokens":[{"text":"The"},{"text":"grace","strongs":["G5485"]},{"text":"of"},{"text":"our","strongs":["G2257"]},{"text":"Lord","strongs":["G2962"]},{"text":"Jesus","strongs":["G2424"]},{"text":"Christ","strongs":["G5547"]},{"text":"be"},{"text":"with","strongs":["G3326"]},{"text":"your","strongs":["G5216"]},{"text":"spirit","strongs":["G4151"]},{"text":"."},{"text":"Amen","strongs":["G0281"]},{"text":". Written from Rome to Philemon, by Onesimus, a servant."}]}]}}}